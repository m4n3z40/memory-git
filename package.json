{
  "name": "memory-git",
  "version": "3.6.0",
  "description": "In-memory Git for AI agents, slow filesystems (EFS/NFS), and test harnesses. Bash-like exec() dispatcher, no subprocess, isolated per-instance volumes, .gitignore-aware loading, explicit flush.",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapters/just-bash": {
      "types": "./dist/adapters/just-bash.d.ts",
      "require": "./dist/adapters/just-bash.js",
      "default": "./dist/adapters/just-bash.js"
    }
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "example": "node examples/example.js",
    "benchmark": "node benchmarks/benchmark.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "keywords": [
    "git",
    "memory",
    "in-memory",
    "isomorphic-git",
    "memfs",
    "vfs",
    "virtual-filesystem",
    "git-in-memory",
    "flush",
    "non-blocking",
    "typescript",
    "ai-agents",
    "agent",
    "llm",
    "claude",
    "git-cli",
    "exec",
    "gitignore",
    "efs",
    "nfs"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m4n3z40/memory-git.git"
  },
  "bugs": {
    "url": "https://github.com/m4n3z40/memory-git/issues"
  },
  "homepage": "https://github.com/m4n3z40/memory-git#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@11.1.1",
  "dependencies": {
    "ignore": "^7.0.5",
    "isomorphic-git": "^1.38.1",
    "memfs": "^4.57.2",
    "mri": "^1.2.0",
    "shell-quote": "^1.8.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/shell-quote": "^1.7.5",
    "@vitest/coverage-v8": "^4.1.7",
    "just-bash": "^3.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "just-bash": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "just-bash": {
      "optional": true
    }
  }
}
